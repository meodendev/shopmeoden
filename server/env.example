PORT=5000
# Chuỗi kết nối PostgreSQL (Neon / Supabase / Render Postgres...)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Đặt false nếu chạy Postgres local không có SSL
DATABASE_SSL=true
# Chuỗi ngẫu nhiên dài: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi_thanh_chuoi_ngau_nhien_dai
# 64 ký tự hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCOUNT_ENCRYPTION_KEY=
# Tài khoản admin tự tạo khi server khởi động lần đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi_mat_khau_admin
# Địa chỉ web frontend (GitHub Pages), nhiều địa chỉ ngăn cách bằng dấu phẩy
CLIENT_URL=http://localhost:8080,https://TEN_BAN.github.io
INITIAL_USER_COINS=0
